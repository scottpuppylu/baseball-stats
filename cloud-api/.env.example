# Secure data API (Vercel project root: cloud-api/). Copy to .env.local for local runs; set the real values only in
# Vercel → Project → Settings → Environment Variables. Never commit real values, never put them in the website or APK.

# Fine-grained personal access token: Repository access = only scottpuppylu/baseball-stats,
# Permissions = Contents: Read and write (nothing else). The code only ever touches data/*.json on the `data` branch.
GITHUB_DATA_TOKEN=
GITHUB_REPO=scottpuppylu/baseball-stats
GITHUB_DATA_BRANCH=data

# Random secret for signing sessions (at least 32 characters), e.g.  node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
# Rotating it signs everyone out.
SESSION_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (type: Web application).
# Authorized redirect URI: <API_PUBLIC_URL>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public base URL of this API deployment, without a trailing slash, e.g. https://baseball-stats-api.vercel.app
API_PUBLIC_URL=

# Who may write (comma-separated Google account emails). Everyone else can only read the public statistics.
# editor: logs, games, guests, avatars, tags.  admin: everything, including the coach-only position rankings.
ADMIN_EMAILS=
EDITOR_EMAILS=

# Sites allowed to call the API from a browser (CORS is not access control; the signed session is).
ALLOWED_ORIGINS=https://scottpuppylu.github.io,https://localhost,capacitor://localhost
# Exact places the login may return to: the website/PWA and the Android app's own link.
ALLOWED_RETURN_URLS=https://scottpuppylu.github.io/baseball-stats/,io.github.scottpuppylu.baseballstats://auth
