{
  "appId": "io.github.scottpuppylu.baseballstats",
  "appName": "淡江航太系壘",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#070a12"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#070a12",
      "showSpinner": false,
      "androidScaleType": "CENTER_INSIDE"
    },
    "SystemBars": {
      "style": "DARK"
    }
  }
}