# Never paste actual credentials into this file or chat.
# For Wrangler local runs, copy bot/.dev.vars.example to bot/.dev.vars.
# For production, use wrangler secret put --config bot/wrangler.jsonc.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Explicit allowlists, comma separated; blank fails closed.
ALLOWED_GROUP_IDS=
BOT_OWNER_USER_IDS=
ALLOW_PUBLIC_STATS=false
ENABLE_PUSH=false
# Bot reads the same public data branch as the website. No GitHub write token needed.
DATA_BASE_URL=https://raw.githubusercontent.com/scottpuppylu/baseball-stats/data/data
